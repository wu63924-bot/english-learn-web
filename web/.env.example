# 前端（构建时注入，只能放公开地址，绝不能放密钥）
VITE_AI_API_URL=http://127.0.0.1:8788

# 后端代理：mock 不联网、不花钱；openai 走 OpenAI 兼容接口（当前按 DeepSeek 官方文档配置）
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# DeepSeek 思考模式：disabled 更省钱更快；需要更强推理时改 enabled
AI_THINKING=disabled
AI_JSON_MODE=on
HOST=127.0.0.1
PORT=8788
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 超时、限流、预算
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_MAX_CONCURRENT=2
AI_DAILY_REQUEST_LIMIT=60
AI_DAILY_TOKEN_LIMIT=200000
# 一节课的 JSON 输出较长；DeepSeek 截断时会返回 finish_reason=length
AI_MAX_OUTPUT_TOKENS=8000

# 模拟供应商的人为延迟（毫秒），用于测试加载与超时
MOCK_LATENCY_MS=0
