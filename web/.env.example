# 前端（构建时注入，只能放公开地址，绝不能放密钥）
VITE_AI_API_URL=http://127.0.0.1:8788

# 后端代理：mock 不联网、不花钱；openai 使用 OpenAI 兼容接口
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-flash
AI_JSON_MODE=on
HOST=127.0.0.1
PORT=8788
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 超时、限流、预算
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_MAX_CONCURRENT=2
AI_DAILY_REQUEST_LIMIT=60
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_OUTPUT_TOKENS=2400

# 模拟供应商的人为延迟（毫秒），用于测试加载与超时
MOCK_LATENCY_MS=0
